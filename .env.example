# Copy this file to ".env" and fill in values. NEVER commit your real .env (it's gitignored).

# --- LLM (required for resume/narrative parsing) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Database (default is a local SQLite file; no setup needed) ---
DATABASE_URL=sqlite:///./joblead.db

# --- Paid data sources (leave blank until you subscribe; connect in the app UI instead) ---
SERPAPI_API_KEY=
INDEED_VENDOR_TOKEN=

# --- Free data sources (free signup keys) ---
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
USAJOBS_API_KEY=
USAJOBS_EMAIL=
